{
  "name": "campusconnect-backend",
  "version": "2.0.0",
  "description": "CampusConnect full-stack campus coursework and events application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo": "node scripts/localDemo.js",
    "check-db": "node scripts/checkDatabase.js",
    "provision": "node scripts/account.js create",
    "reset-password": "node scripts/account.js reset",
    "test": "node --test --test-concurrency=1 tests/api.test.js",
    "test:browser": "node tests/browser.cjs",
    "format": "prettier --write \"**/*.{js,cjs,json}\" \"../frontend/**/*.{js,css,html}\" \"../docs/*.md\" ../README.md --ignore-path ../.prettierignore",
    "format:check": "prettier --check \"**/*.{js,cjs,json}\" \"../frontend/**/*.{js,css,html}\" \"../docs/*.md\" ../README.md --ignore-path ../.prettierignore"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.9",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1",
    "multer": "^2.0.2",
    "yauzl": "^3.2.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.3.0",
    "playwright": "^1.58.0",
    "supertest": "^7.2.0",
    "axe-core": "^4.10.0",
    "prettier": "^3.5.0"
  }
}
